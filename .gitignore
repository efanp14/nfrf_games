# Prevents local import data from bloating the repo
.godot/

# NOTE: *.uid is deliberately NOT ignored. It was, under the belief that these
# were editor settings; they are not. Godot 4.4+ writes a .uid file beside every
# script and resource holding its stable identity, project.godot refers to the
# GameManager autoload by UID rather than by path, and .tscn files reference
# scripts the same way. With them ignored, a fresh clone could not resolve the
# autoload at all: "Unrecognized UID" then "Failed to create an autoload", after
# which every script inferring a type from GameManager failed to parse and the
# project would not open. Commit them.

# Ignore mobile export folders if you ever create them
/android/
/ios/

# Local build exports. Keep every spelling here: the folder that actually gets
# used is /Builds/, which slipped past a rule that only said /build/ and left
# two 99MB .exe files one `git add -A` away from the repo. GitHub refuses a
# file over 100MB, so that push fails halfway rather than cleanly.
/build/
/Build/
/builds/
/Builds/
/bin/
*.exe
*.apk
*.aab
*.pck

# Temporary files created by some OS or editors
.tmp/
*.tmp

# Local assistant/editor notes and settings — not part of the project
CLAUDE.md
.claude/

# The export preset is machine-specific (it holds local SDK and keystore paths),
# so it stays on the machine that made it rather than syncing half-valid paths.
export_presets.cfg

# Sample-log generation tooling stays local: it writes into user://, and its
# output is development data rather than anything the project ships.
tools/generate_sample_logs.gd

# Python bytecode from running the analysis tools locally
__pycache__/
*.pyc
